# Copy to backend/.env and fill in.

# SAM.gov public API key: sign in at sam.gov > Account Details > request a Public API Key.
SAM_API_KEY=

# Optional. Enables Claude-powered solicitation breakdowns and compliance matrices.
# Without it, a rule-based analyzer is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional email digest (python -m app.cli digest --email)
DIGEST_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Address used for links in the daily digest email (default http://localhost:5173)
APP_URL=http://localhost:8000

# Login (required on a hosted site; leave APP_PASSWORD blank to run open on your own computer)
APP_USERNAME=
APP_PASSWORD=
SESSION_SECRET=
CALENDAR_TOKEN=
COOKIE_SECURE=
